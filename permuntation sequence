class Solution(object):

    def getPermutation(self, n, k):
        """
        :type n: int
        :type k: int
        :rtype: str
        """
        numbers = [str(i) for i in range(1, n + 1)]
        result = []

        # Convert k to 0-based index
        k -= 1

        # Calculate factorials
        factorial = 1
        for i in range(1, n):
            factorial *= i

        while numbers:
            index = k // factorial
            result.append(numbers.pop(index))

            if not numbers:
                break

            k %= factorial
            factorial //= len(numbers)

        return ''.join(result)
